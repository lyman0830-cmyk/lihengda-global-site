---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBanner from "../components/CtaBanner.astro";

const faqs = [
  {
    q: "What's the difference between manufacturing in China and Vietnam?",
    a: "It comes down to tariff exposure, workforce, and which processes a factory actually has in-house. Lihengda's Ningbo, China facility (est. 2009) has a mature supply chain, established tooling, and in-house metrology — but no laser cutting. Our Ho Chi Minh City, Vietnam facility (est. 2025) offers country-of-origin outside China and adds laser cutting, laser tube cutting and bending, which Ningbo doesn't have.",
  },
  {
    q: "When does it make sense to manufacture in Vietnam instead of China?",
    a: "Three common reasons: you need country-of-origin outside China for tariff purposes, you want a China+1 supply chain so you're not single-sourced, or your part needs laser-cut sheet metal — which our Vietnam facility does and our Ningbo facility does not.",
  },
  {
    q: "Can one supplier produce part of my order in China and part in Vietnam?",
    a: "Yes, at Lihengda. Our Vietnam facility is a subsidiary of the Ningbo company — same management, one point of contact — so work can be split across both bases by process or by volume as your sourcing needs change.",
  },
  {
    q: "Do both of Lihengda's facilities hold the same certifications?",
    a: "No. Both facilities have completed amfori BSCI monitoring. Only our Ningbo facility is ISO 9001, ISO 14001 and ISO 45001 certified — our Vietnam facility does not hold ISO certification.",
  },
  {
    q: "What manufacturing processes does each Lihengda base have in-house?",
    a: "Ningbo, China: plastic injection molding (including insert molding and overmolding), CNC machining, welding, tube bending, box-build assembly, functional testing, inspection, and packaging (including cleanroom). Ho Chi Minh City, Vietnam: the same injection molding, CNC machining, assembly, inspection and packaging, plus laser cutting, laser tube cutting, bending, and robotic and TIG welding.",
  },
  {
    q: "Does either facility offer two-shot (two-color) injection molding?",
    a: "No — neither our Ningbo nor our Vietnam facility currently offers two-shot molding. If your part needs it, tell us early in the DFM review and we'll discuss alternatives.",
  },
  {
    q: "What should I send a manufacturer to get an accurate quote?",
    a: "CAD files or drawings, your target material, target volume, and rough timeline. For crowdfunding or early-stage products, a working prototype or reference sample also helps us scope tooling and DFM changes faster.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="China vs Vietnam Manufacturing — FAQ"
  description="Common questions on choosing between a China and Vietnam contract manufacturer — certifications, processes, tariffs, and splitting production across both."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHero
    eyebrow="FAQ"
    title="Choosing a China vs Vietnam manufacturer"
    lede="Straight answers to the questions we get most from buyers comparing Ningbo, China and Ho Chi Minh City, Vietnam — or ask us directly and we'll recommend one, or both."
  />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="rounded-lg border border-[var(--color-line)] bg-white p-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">The short version</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
        <li><strong>Need country of origin outside China, or a China+1 supply chain?</strong> Vietnam (opened 2025).</li>
        <li><strong>Need a mature supply chain, established tooling and in-house inspection equipment?</strong> Ningbo (since 2009).</li>
        <li><strong>Need laser-cut sheet metal?</strong> Vietnam. Our Ningbo facility does not have laser cutting.</li>
        <li><strong>Not sure?</strong> Many programs split work across both bases, under one point of contact.</li>
      </ul>
    </div>

    <div class="mt-8 divide-y divide-[var(--color-line)] rounded-lg border border-[var(--color-line)] bg-white">
      {faqs.map((f, i) => (
        <details class="group p-5" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-base font-semibold text-[var(--color-navy)]">
            <span>{f.q}</span>
            <span class="mt-1 shrink-0 text-[var(--color-steel)] transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>

    <p class="mt-12 text-sm text-slate-500">
      See the full side-by-side breakdown on our <a href="/china-vietnam/" class="font-semibold text-[var(--color-steel)] hover:underline">China &amp; Vietnam comparison page</a>, or compliance details on our <a href="/supplier-compliance-faq/" class="font-semibold text-[var(--color-steel)] hover:underline">Supplier Compliance FAQ</a>.
    </p>
  </section>

  <CtaBanner heading="Not sure which base fits?" body="Tell us your target market, tariff situation and volume — we'll recommend China, Vietnam, or both." />
</Layout>
