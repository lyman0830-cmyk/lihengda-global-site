---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import PhotoBand from "../../components/PhotoBand.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import qualityLabPhoto from "../../assets/photos/video-quality-lab.jpg";
import robotArmPhoto from "../../assets/photos/video-robot-arm.jpg";
import heroPhoto from "../../assets/photos/assembly-line-wide.jpg";
import weldingPhoto from "../../assets/photos/vietnam-robotic-welding.jpg";
import injectionThumb from "../../assets/photos/injection-molding-machines.jpg";
import sheetMetalThumb from "../../assets/photos/tube-bending-ningbo.jpg";
import cncThumb from "../../assets/photos/cnc-machines.jpg";
import assemblyThumb from "../../assets/photos/assembly-line-worker.jpg";

const steps = [
  "DFM review",
  "Tooling (soft / aluminum / steel)",
  "Prototyping",
  "Pilot run",
  "Injection molding & metal fabrication",
  "Sub-assembly",
  "Box-build assembly",
  "Functional testing & inspection",
  "Packaging (incl. cleanroom)",
  "Shipment",
];

const phaseGroups = [
  { name: "Design & Tooling", start: 1, steps: steps.slice(0, 4) },
  { name: "Production", start: 5, steps: steps.slice(4, 8) },
  { name: "Delivery & QC", start: 9, steps: steps.slice(8, 10) },
];

const moldLabels: { side: "left" | "right"; y: number; dotX: number; dotY: number; text: string }[] = [
  { side: "right", y: 55, dotX: 345, dotY: 60, text: "SPRUE BUSHING" },
  { side: "right", y: 140, dotX: 570, dotY: 125, text: "COOLING CHANNEL" },
  { side: "right", y: 183, dotX: 400, dotY: 183, text: "RUNNER" },
  { side: "right", y: 226, dotX: 525, dotY: 190, text: "MOLDED PART" },
  { side: "right", y: 269, dotX: 515, dotY: 260, text: "EJECTOR PIN" },
  { side: "left", y: 97, dotX: 230, dotY: 125, text: "CAVITY (A SIDE)" },
  { side: "left", y: 183, dotX: 462, dotY: 184, text: "GATE" },
  { side: "left", y: 269, dotX: 230, dotY: 250, text: "CORE (B SIDE)" },
];

const services = [
  { n: "01", title: "DFM Review", body: "Before tooling starts, we review your CAD for tooling risk, tolerance stack-up and assembly issues — and tell you what needs to change, not just what we can quote." },
  { n: "02", title: "Tooling Strategy", body: "Soft or aluminum tooling for low-volume and early production; steel tooling once you're ready to scale. We help you match the tooling investment to your actual volume." },
  { n: "03", title: "Material Selection", body: "Plastics — ABS, PP, PE, PA, POM — and metals — stainless steel, carbon steel, aluminum, zinc alloy. We help you weigh function, cost and manufacturability before you lock a spec." },
  { n: "04", title: "Dimensional Verification", body: "Our Ningbo QC lab — CMM, profile projector, salt spray tester, temperature chamber and more — checks that parts actually match your CAD, not just that they look right." },
];

const pages = [
  { href: "/manufacturing/injection-molding/", title: "Injection Molding", body: "Insert molding, overmolding, soft and aluminum tooling for low-volume runs.", img: injectionThumb },
  { href: "/manufacturing/sheet-metal-welding/", title: "Sheet Metal & Welding", body: "Laser cutting, laser tube cutting, bending, robotic and TIG welding.", img: sheetMetalThumb },
  { href: "/manufacturing/cnc-machining/", title: "CNC Machining", body: "Metal parts, fixtures and low-volume components.", img: cncThumb },
  { href: "/manufacturing/box-build-assembly/", title: "Box-Build Assembly, Inspection & Packaging", body: "Final assembly, functional testing, inspection, retail-ready packaging.", img: assemblyThumb },
];
---

<Layout
  title="Engineering & Manufacturing"
  description="From DFM review and tooling strategy through molding, metal fabrication, assembly, testing, inspection and packaging — one connected team, two manufacturing bases."
>
  <PageHero
    eyebrow="Engineering & Manufacturing"
    title="From CAD review to a packed, inspected product"
    lede="Design decisions stay connected to tooling, production and assembly. When something needs to change, the people reviewing your CAD and the people making the parts work through it as one team."
  >
    <div class="mt-6 flex items-center gap-3 text-sm text-slate-600">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-bg)] text-xs font-bold text-[var(--color-navy)]">5</span>
      <span>engineers, working in SolidWorks and UG (NX)</span>
    </div>
  </PageHero>

  <PhotoBand
    src={heroPhoto}
    alt="Assembly line with team members at work, Ningbo facility"
    caption="Assembly line, Ningbo facility."
  />

  <section class="industrial-grid border-b border-[var(--color-line)] bg-[var(--color-bg)]">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">One continuous program</p>
      <h2 class="mt-2 text-xl font-semibold text-[var(--color-navy)]">The complete workflow</h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-3 lg:gap-6">
        {phaseGroups.map((phase, pi) => (
          <div class="relative">
            <div
              class:list={[
                "h-full rounded-xl border-t-4 border-x border-b border-[var(--color-line)] bg-white p-5 shadow-sm",
                pi === 0 && "border-t-[var(--color-accent)]",
                pi === 1 && "border-t-[var(--color-steel)]",
                pi === 2 && "border-t-[var(--color-navy)]",
              ]}
            >
              <h3
                class:list={[
                  "text-xs font-bold uppercase tracking-wide",
                  pi === 0 && "text-[var(--color-accent)]",
                  pi === 1 && "text-[var(--color-steel)]",
                  pi === 2 && "text-[var(--color-navy)]",
                ]}
              >
                Phase {pi + 1} &middot; {phase.name}
              </h3>
              <ol class="mt-4 space-y-4">
                {phase.steps.map((step, si) => (
                  <li class="flex items-start gap-3">
                    <span
                      class:list={[
                        "flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white",
                        pi === 0 && "bg-[var(--color-accent)]",
                        pi === 1 && "bg-[var(--color-steel)]",
                        pi === 2 && "bg-[var(--color-navy)]",
                      ]}
                    >
                      {phase.start + si}
                    </span>
                    <span class="pt-0.5 text-sm leading-snug text-slate-700">{step}</span>
                  </li>
                ))}
              </ol>
            </div>

            {pi < phaseGroups.length - 1 && (
              <div class="pointer-events-none absolute -right-6 top-8 z-10 hidden h-8 w-8 items-center justify-center rounded-full border border-[var(--color-line)] bg-[var(--color-bg)] text-[var(--color-steel)] lg:flex">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="engineering" class="scroll-mt-20 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Engineering</p>
          <h2 class="mt-2 max-w-lg text-2xl font-bold text-[var(--color-navy)] sm:text-3xl">
            The important decisions happen before production starts
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-slate-600">
            Our 5-person engineering team works in SolidWorks and UG (NX),
            reviewing every project before a mold gets cut or a line gets set up.
          </p>
        </div>
        <figure class="relative h-64 overflow-hidden rounded-xl border border-[var(--color-line)] sm:h-72">
          <Image
            src={qualityLabPhoto}
            alt="Reviewing an inspection report against CAD, Ningbo facility"
            widths={[480, 768, 1100]}
            sizes="(min-width: 1024px) 520px, 100vw"
            class="h-full w-full object-cover"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent px-5 pb-3 pt-10 text-xs font-medium text-white">
            Verifying against CAD, Ningbo facility
          </figcaption>
        </figure>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <div class="rounded-lg border-t-4 border-[var(--color-accent)] bg-[var(--color-bg)] p-6">
            <span class="text-xs font-bold tracking-widest text-[var(--color-steel)]">{s.n}</span>
            <h3 class="mt-3 text-base font-semibold text-[var(--color-navy)]">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engineering depth: mold anatomy + DFM examples -->
  <section class="bg-[var(--color-navy)] py-16">
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <defs>
        <linearGradient id="toolSteel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#b6c0cc" />
          <stop offset="100%" stop-color="#7e8b9a" />
        </linearGradient>
        <linearGradient id="toolSteelDark" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#8b97a6" />
          <stop offset="100%" stop-color="#59636f" />
        </linearGradient>
        <linearGradient id="plasticAmber" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f3c98a" />
          <stop offset="100%" stop-color="#dc8a2e" />
        </linearGradient>
        <filter id="engShadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#000" flood-opacity="0.35" />
        </filter>
      </defs>
    </svg>

    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-accent-light)]">Engineering, in practice</p>
      <h2 class="mt-2 max-w-2xl text-2xl font-bold text-white sm:text-3xl">
        From mold design to a finished, inspected part
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-slate-400">
        Illustrative diagrams — generic geometry, not a client project.
      </p>

      <!-- Mold anatomy -->
      <div class="blueprint-grid mt-8 overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-6">
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">Anatomy of an injection mold</h3>
        <svg viewBox="0 0 800 380" class="mt-4 w-full" role="img" aria-labelledby="mold-anatomy-title">
          <title id="mold-anatomy-title">Cross-section of a two-plate injection mold, labeled with its main components</title>

          {moldLabels.map((l) => (
            <line
              x1={l.dotX}
              y1={l.dotY}
              x2={l.side === "right" ? 690 : 110}
              y2={l.y}
              stroke="#4d5c70"
              stroke-width="1"
            />
          ))}

          <g filter="url(#engShadow)">
            <rect x="140" y="40" width="520" height="24" fill="#2a3a4d" />
            <rect x="140" y="64" width="520" height="126" fill="url(#toolSteel)" />
            <rect x="140" y="190" width="520" height="110" fill="url(#toolSteelDark)" />
            <rect x="400" y="314" width="200" height="26" fill="#2a3a4d" />
            <rect x="140" y="340" width="520" height="24" fill="#2a3a4d" />

            <polygon points="333,40 357,40 350,182 340,182" fill="url(#toolSteel)" />
            <circle cx="345" cy="186" r="7" fill="url(#toolSteel)" />
            <rect x="345" y="179" width="110" height="8" fill="url(#toolSteel)" />
            <rect x="455" y="180" width="15" height="10" fill="var(--color-accent)" />
            <rect x="470" y="165" width="60" height="50" rx="4" fill="url(#plasticAmber)" stroke="var(--color-accent-light)" stroke-width="1" />

            <rect x="483" y="215" width="5" height="99" fill="url(#toolSteelDark)" />
            <rect x="498" y="215" width="5" height="99" fill="url(#toolSteelDark)" />
            <rect x="513" y="215" width="5" height="99" fill="url(#toolSteelDark)" />
          </g>

          <circle cx="230" cy="125" r="10" fill="none" stroke="#4d5c70" stroke-width="1.5" stroke-dasharray="2 2" />
          <circle cx="570" cy="125" r="10" fill="none" stroke="#4d5c70" stroke-width="1.5" stroke-dasharray="2 2" />
          <circle cx="230" cy="250" r="10" fill="none" stroke="#3a4553" stroke-width="1.5" stroke-dasharray="2 2" />
          <circle cx="570" cy="250" r="10" fill="none" stroke="#3a4553" stroke-width="1.5" stroke-dasharray="2 2" />

          <line x1="120" y1="190" x2="680" y2="190" stroke="var(--color-accent-light)" stroke-width="1.5" stroke-dasharray="7 4" opacity="0.6" />

          {moldLabels.map((l) => (
            <circle cx={l.dotX} cy={l.dotY} r="2.5" fill="var(--color-accent-light)" />
          ))}

          {moldLabels.map((l) => (
            <text
              x={l.side === "right" ? 698 : 102}
              y={l.y + 3}
              fill="#c3ccd6"
              font-size="10"
              font-weight="700"
              letter-spacing="0.02em"
              text-anchor={l.side === "right" ? "start" : "end"}
            >
              {l.text}
            </text>
          ))}
        </svg>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-300">
          A two-plate mold, in cross-section: melted plastic runs from the sprue bushing through
          the runner and gate into the cavity, cools against the cavity (A side) and core (B side)
          steel, then the ejector pins push the finished part free along the parting line.
        </p>
      </div>

      <!-- DFM case studies -->
      <h3 class="mt-12 text-sm font-bold uppercase tracking-wide text-white">DFM checks we run before steel is cut</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="blueprint-grid overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <h4 class="text-sm font-bold text-white">Sink marks</h4>
          <p class="mt-1 text-xs text-slate-400">Rib-to-wall thickness ratio</p>

          <svg viewBox="0 0 320 150" class="mt-4 w-full" role="img" aria-labelledby="dfm-sink-title">
            <title id="dfm-sink-title">A rib close to the outer wall thickness causes a sink mark; a thinner, cored rib resolves it</title>
            <line x1="160" y1="12" x2="160" y2="122" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="3 3" />

            <g filter="url(#engShadow)">
              <rect x="20" y="15" width="120" height="16" rx="2" fill="url(#toolSteel)" />
              <rect x="70" y="31" width="22" height="60" rx="2" fill="url(#toolSteel)" />
              <rect x="180" y="15" width="120" height="16" rx="2" fill="url(#toolSteel)" />
              <rect x="228" y="31" width="16" height="60" rx="2" fill="url(#toolSteel)" />
              <rect x="231" y="31" width="8" height="38" fill="var(--color-navy)" stroke="#5fd0a8" stroke-width="0.75" stroke-dasharray="1.5 1.5" />
            </g>

            <circle cx="81" cy="19" r="5" fill="none" stroke="#f0b45c" stroke-width="1.75" stroke-dasharray="2 2" />
            <circle cx="236" cy="19" r="5.5" fill="#0f2436" stroke="#5fd0a8" stroke-width="1.25" />
            <path d="M233 19 l2 2 l4 -4.5" fill="none" stroke="#5fd0a8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

            <text x="81" y="112" fill="#c3ccd6" font-size="9" text-anchor="middle">rib ≈ 80% t</text>
            <text x="236" y="112" fill="#c3ccd6" font-size="9" text-anchor="middle">rib ≈ 55% + cored</text>
            <text x="80" y="135" fill="#94a3b8" font-size="8.5" font-weight="700" letter-spacing="0.05em" text-anchor="middle">BEFORE</text>
            <text x="240" y="135" fill="#5fd0a8" font-size="8.5" font-weight="700" letter-spacing="0.05em" text-anchor="middle">AFTER</text>
          </svg>

          <p class="mt-3 text-xs leading-relaxed text-slate-300">
            A rib nearly as thick as the wall cools unevenly and pulls a
            visible dimple into the outer face. Thinning and coring the rib
            removes the risk.
          </p>
        </div>

        <div class="blueprint-grid overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <h4 class="text-sm font-bold text-white">Draft angle</h4>
          <p class="mt-1 text-xs text-slate-400">Can the part release from the mold?</p>

          <svg viewBox="0 0 320 150" class="mt-4 w-full" role="img" aria-labelledby="dfm-draft-title">
            <title id="dfm-draft-title">A boss with vertical walls drags on ejection; a tapered boss releases cleanly</title>
            <line x1="160" y1="12" x2="160" y2="122" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="3 3" />

            <g filter="url(#engShadow)">
              <rect x="20" y="88" width="120" height="12" fill="url(#toolSteel)" />
              <rect x="60" y="30" width="40" height="58" fill="url(#toolSteel)" />
              <rect x="180" y="88" width="120" height="12" fill="url(#toolSteel)" />
              <polygon points="222,88 258,88 251,30 229,30" fill="url(#toolSteel)" />
            </g>

            <path d="M80 26 l-6 -10 M80 26 l6 -10" stroke="#f0b45c" stroke-width="1.75" stroke-linecap="round" />
            <path d="M64 34 l7 6 M96 34 l-7 6" stroke="#f0b45c" stroke-width="1.5" stroke-linecap="round" />
            <path d="M240 26 v-14" stroke="#5fd0a8" stroke-width="1.75" stroke-linecap="round" />
            <path d="M235 16 l5 -6 l5 6" fill="none" stroke="#5fd0a8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

            <text x="80" y="112" fill="#c3ccd6" font-size="9" text-anchor="middle">0&#176; draft</text>
            <text x="240" y="112" fill="#c3ccd6" font-size="9" text-anchor="middle">2&#176; draft</text>
            <text x="80" y="135" fill="#94a3b8" font-size="8.5" font-weight="700" letter-spacing="0.05em" text-anchor="middle">BEFORE</text>
            <text x="240" y="135" fill="#5fd0a8" font-size="8.5" font-weight="700" letter-spacing="0.05em" text-anchor="middle">AFTER</text>
          </svg>

          <p class="mt-3 text-xs leading-relaxed text-slate-300">
            Vertical walls drag and scuff against the steel as the part
            ejects. A couple of degrees of draft lets it release cleanly,
            every cycle.
          </p>
        </div>

        <div class="blueprint-grid overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <h4 class="text-sm font-bold text-white">Wall thickness transition</h4>
          <p class="mt-1 text-xs text-slate-400">Thick-to-thin wall junctions</p>

          <svg viewBox="0 0 320 150" class="mt-4 w-full" role="img" aria-labelledby="dfm-wall-title">
            <title id="dfm-wall-title">An abrupt wall thickness step warps on cooling; a gradual transition resolves it</title>
            <line x1="160" y1="12" x2="160" y2="122" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="3 3" />

            <g filter="url(#engShadow)">
              <path d="M20,96 L20,40 L80,40 L80,66 L140,66 L140,96 Z" fill="url(#toolSteel)" />
              <path d="M180,96 L180,40 L240,40 L265,60 L300,60 L300,96 Z" fill="url(#toolSteel)" />
            </g>

            <path d="M50 34 q10 -10 20 0" fill="none" stroke="#f0b45c" stroke-width="1.5" stroke-linecap="round" />
            <circle cx="80" cy="37" r="4" fill="none" stroke="#f0b45c" stroke-width="1.5" stroke-dasharray="1.5 1.5" />
            <path d="M245 22 l4 4 l7 -8" fill="none" stroke="#5fd0a8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

            <text x="80" y="112" fill="#c3ccd6" font-size="9" text-anchor="middle">abrupt step</text>
            <text x="240" y="112" fill="#c3ccd6" font-size="9" text-anchor="middle">gradual transition</text>
            <text x="80" y="135" fill="#94a3b8" font-size="8.5" font-weight="700" letter-spacing="0.05em" text-anchor="middle">BEFORE</text>
            <text x="240" y="135" fill="#5fd0a8" font-size="8.5" font-weight="700" letter-spacing="0.05em" text-anchor="middle">AFTER</text>
          </svg>

          <p class="mt-3 text-xs leading-relaxed text-slate-300">
            A sharp step between thick and thin walls cools unevenly and
            warps. A chamfered or radiused transition keeps the part flat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <figure class="relative order-2 h-80 overflow-hidden rounded-xl border border-[var(--color-line)] sm:h-[28rem] lg:order-1">
          <Image
            src={weldingPhoto}
            alt="Robotic welding arm working on an aluminum frame, Vietnam facility"
            widths={[480, 768, 1100]}
            sizes="(min-width: 1024px) 520px, 100vw"
            class="h-full w-full object-cover"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent px-5 pb-3 pt-10 text-xs font-medium text-white">
            Robotic welding, Vietnam facility
          </figcaption>
        </figure>
        <div class="order-1 lg:order-2">
          <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Metal fabrication</p>
          <h2 class="mt-2 max-w-lg text-2xl font-bold text-[var(--color-navy)] sm:text-3xl">
            Robotic and TIG welding, run in-house
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-slate-600">
            Metal frames and enclosures are laser cut, bent and welded at our
            Vietnam facility, then fed straight into assembly alongside the
            molded parts — no handoff to a separate metal shop.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Factory capabilities</p>
      <h2 class="mt-2 text-xl font-semibold text-[var(--color-navy)]">Explore each manufacturing process</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {pages.map((p, i) => (
          <a href={p.href} class:list={["group overflow-hidden rounded-lg border-l-4 bg-[var(--color-bg)] transition hover:-translate-y-0.5 hover:shadow-sm", i % 2 === 0 ? "border-[var(--color-accent)]" : "border-[var(--color-steel)]"]}>
            <Image
              src={p.img}
              alt={p.title}
              widths={[400, 640, 900]}
              sizes="(min-width: 640px) 420px, 100vw"
              class="h-40 w-full object-cover"
            />
            <div class="p-6">
              <h3 class="text-base font-semibold text-[var(--color-navy)] group-hover:text-[var(--color-steel)]">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.body}</p>
            </div>
          </a>
        ))}
      </div>

      <figure class="relative mt-8 h-72 overflow-hidden rounded-xl border border-[var(--color-line)] sm:h-96">
        <Image
          src={robotArmPhoto}
          alt="Automation equipment on our production floor"
          widths={[640, 1024, 1600]}
          sizes="100vw"
          class="h-full w-full object-cover"
        />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent px-6 pb-5 pt-16 text-sm font-medium text-white">
          Production automation, Ningbo facility
        </figcaption>
      </figure>
    </div>
  </section>

  <CtaBanner />
</Layout>
