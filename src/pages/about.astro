---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PhotoBand from "../components/PhotoBand.astro";
import CtaBanner from "../components/CtaBanner.astro";
import officePhoto from "../assets/photos/ningbo-office-corridor.jpg";
import entrancePhoto from "../assets/photos/ningbo-facility-entrance.jpg";
import teamPhoto from "../assets/photos/video-office-team.jpg";
import isoCertsPhoto from "../assets/photos/ningbo-iso-certificates.jpg";
---

<Layout
  title="About & Compliance"
  description="Lihengda operates two manufacturing bases: Ningbo Lihengda Machinery Co., Ltd. in Ningbo, China (est. 2009) and Lihengda (Vietnam) International Co., Ltd. in Ho Chi Minh City (est. 2025)."
>
  <PageHero eyebrow="About" title="About Lihengda" />

  <PhotoBand
    src={officePhoto}
    alt="The office corridor at our Ningbo facility"
    caption="Our Ningbo office."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="prose-body lg:col-span-2">
        <p>
          Lihengda operates two manufacturing bases. Ningbo Lihengda
          Machinery Co., Ltd. was established in Ningbo, China in 2009. In
          June 2025 we opened Lihengda (Vietnam) International Co., Ltd. in
          Ho Chi Minh City to give customers a manufacturing option outside
          China. The Vietnam company is a subsidiary of the Ningbo company.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <Image
            src={entrancePhoto}
            alt="The entrance to our Ningbo facility"
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 350px, 100vw"
            class="h-56 w-full rounded-lg border border-[var(--color-line)] object-cover sm:h-64"
          />
          <Image
            src={teamPhoto}
            alt="Our team at work in the Ningbo office"
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 350px, 100vw"
            class="h-56 w-full rounded-lg border border-[var(--color-line)] object-cover sm:h-64"
          />
        </div>

        <h2 class="text-lg font-semibold text-[var(--color-navy)]">Compliance</h2>
        <ul>
          <li>Both facilities have completed amfori BSCI monitoring. Monitoring information is available for review on request.</li>
          <li>Our Ningbo facility is ISO 9001, ISO 14001 and ISO 45001 certified.</li>
        </ul>

        <figure class="mx-auto mt-2 max-w-xs text-center">
          <Image
            src={isoCertsPhoto}
            alt="Ningbo facility ISO 9001, ISO 14001 and ISO 45001 certificates"
            widths={[320, 480, 640]}
            sizes="320px"
            class="w-full rounded-md"
          />
          <figcaption class="mt-2 text-xs text-slate-500">
            Ningbo facility: ISO 9001, ISO 14001 and ISO 45001 certificates.
          </figcaption>
        </figure>

        <p class="text-sm text-slate-500">
          More on certifications and audits: see our <a href="/supplier-compliance-faq/" class="font-semibold text-[var(--color-steel)] hover:underline">Supplier Compliance FAQ</a>.
        </p>

        <h2 class="text-lg font-semibold text-[var(--color-navy)]">Locations</h2>
        <p><strong>Vietnam:</strong> Plot No. 41, Map Sheet No. 6, Ba Tri Quarter, Tan Hiep Ward, Ho Chi Minh City, Vietnam.</p>
        <p><strong>China:</strong> Building 2, No. 110 Xiwu Street, Fenghua District, Ningbo, China.</p>
      </div>

      <aside class="self-start rounded-lg border border-[var(--color-line)] bg-white p-6 lg:sticky lg:top-24">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Contact</h3>
        <p class="mt-3 text-sm font-medium text-[var(--color-navy)]">Lyman Li</p>
        <p class="text-sm text-slate-600">Manager</p>
        <a href="mailto:lyman@lihengda.cc" class="mt-2 inline-block text-sm font-semibold text-[var(--color-steel)] hover:underline">
          lyman@lihengda.cc
        </a>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          <strong class="text-[var(--color-navy)]">China:</strong> Building 2,
          No. 110 Xiwu Street, Fenghua District, Ningbo, China.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          <strong class="text-[var(--color-navy)]">Vietnam:</strong> Plot No.
          41, Map Sheet No. 6, Ba Tri Quarter, Tan Hiep Ward, Ho Chi Minh
          City, Vietnam.
        </p>
      </aside>
    </div>
  </section>

  <CtaBanner />
</Layout>
