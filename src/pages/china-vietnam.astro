---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBanner from "../components/CtaBanner.astro";
import ningboPhoto from "../assets/photos/ningbo-facility-entrance.jpg";
import vietnamPhoto from "../assets/photos/vietnam-facility-entrance.jpg";
import ningboCleanroomPhoto from "../assets/photos/cleanroom-assembly.jpg";
import ningboInjectionPhoto from "../assets/photos/injection-molding-machines.jpg";
import ningboAssemblyPhoto from "../assets/photos/assembly-line-wide.jpg";
import ningboQualityLabPhoto from "../assets/photos/video-quality-lab.jpg";
import vietnamWeldingPhoto from "../assets/photos/vietnam-robotic-welding.jpg";
import vietnamLaserPhoto from "../assets/photos/vietnam-laser-cutting.jpg";
import vietnamCncPhoto from "../assets/photos/vietnam-cnc.jpg";
import vietnamFloorWidePhoto from "../assets/photos/vietnam-injection-floor-wide.jpg";

const ningboGallery = [
  { src: ningboInjectionPhoto, alt: "Injection molding machines, Ningbo facility" },
  { src: ningboAssemblyPhoto, alt: "Assembly line, Ningbo facility" },
  { src: ningboCleanroomPhoto, alt: "Cleanroom assembly area, Ningbo facility" },
  { src: ningboQualityLabPhoto, alt: "Quality lab, Ningbo facility" },
];

const vietnamGallery = [
  { src: vietnamFloorWidePhoto, alt: "Injection molding production floor, Vietnam facility" },
  { src: vietnamWeldingPhoto, alt: "Robotic welding arm, Vietnam facility" },
  { src: vietnamLaserPhoto, alt: "Laser cutting machine, Vietnam facility" },
  { src: vietnamCncPhoto, alt: "CNC machining, Vietnam facility" },
];

type Cell = string | string[];

const rows: [string, Cell, Cell][] = [
  ["Since", "2009", "2025"],
  ["Site", "~6,000 m²", "~7,707 m², 3 production buildings"],
  [
    "Certifications",
    ["amfori BSCI monitoring completed", "ISO 9001, ISO 14001, ISO 45001"],
    ["amfori BSCI monitoring completed"],
  ],
  [
    "In-house processes",
    [
      "Injection molding (incl. insert molding, overmolding; no two-shot)",
      "—",
      "CNC machining",
      "Welding",
      "Tube bending",
      "Box-build assembly",
      "Functional testing, inspection",
      "Packaging (incl. cleanroom)",
    ],
    [
      "Injection molding (incl. insert molding, overmolding; no two-shot)",
      "Laser cutting, laser tube cutting",
      "CNC machining",
      "Robotic & TIG welding",
      "Bending",
      "Assembly",
      "Functional testing, inspection",
      "Packaging (incl. cleanroom)",
    ],
  ],
  [
    "QC lab",
    ["Salt spray tester", "Temperature chamber", "Colorimeter", "CMM", "Profile projector", "Tensile tester", "Hardness tester", "Standard gauges"],
    ["Profile projector", "Calipers", "Standard gauges", "Additional inspection reports available on request"],
  ],
  [
    "Best when you need",
    ["Mature supply chain, cost efficiency", "Established tooling", "In-house metrology / reliability testing"],
    ["Country-of-origin outside China", "Tariff exposure management, China+1 supply chain", "Sheet metal (laser cutting, laser tube cutting)"],
  ],
  ["Relationship", "Parent company", "Subsidiary of the Ningbo company"],
];
---

<Layout
  title="China & Vietnam"
  description="Two manufacturing bases, one point of contact. Compare Ningbo, China and Ho Chi Minh City, Vietnam, or let us recommend one for your project."
>
  <PageHero
    eyebrow="China & Vietnam"
    title="Two manufacturing bases. One point of contact."
    lede="Not sure which base fits? Tell us your target market, tariff situation and volume, and we will recommend one — or split the program across both."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact/"
        class="rounded-md bg-[var(--color-steel)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-steel-light)]"
      >
        Help me choose a base
      </a>
      <a
        href="/choosing-a-manufacturer/"
        class="rounded-md border border-[var(--color-line)] px-6 py-3 text-sm font-semibold text-[var(--color-navy)] transition hover:border-[var(--color-steel)]"
      >
        Read the FAQ
      </a>
    </div>
  </PageHero>

  <section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="relative flex h-80 flex-col justify-end overflow-hidden rounded-xl border border-[var(--color-line)]">
        <Image
          src={ningboPhoto}
          alt="Entrance to our Ningbo, China facility"
          widths={[480, 768, 1100]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="relative p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/70">Parent company · Since 2009</p>
          <h2 class="mt-1 text-2xl font-bold text-white">Ningbo, China</h2>
          <p class="mt-2 max-w-sm text-sm text-slate-200">
            Mature supply chain, cost efficiency, established tooling, in-house metrology and reliability testing.
          </p>
        </div>
      </div>

      <div class="relative flex h-80 flex-col justify-end overflow-hidden rounded-xl border border-[var(--color-line)]">
        <Image
          src={vietnamPhoto}
          alt="Entrance to our Ho Chi Minh City, Vietnam facility"
          widths={[480, 768, 1100]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="relative p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/70">Subsidiary · Since 2025</p>
          <h2 class="mt-1 text-2xl font-bold text-white">Ho Chi Minh City, Vietnam</h2>
          <p class="mt-2 max-w-sm text-sm text-slate-200">
            Country-of-origin outside China, tariff exposure management, China+1 supply chain, sheet metal (laser cutting, laser tube cutting).
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-xl font-semibold text-[var(--color-navy)]">Inside our facilities</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600">
      Real photos from both production floors — not renders.
    </p>

    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Ningbo, China</h3>
        <div class="mt-3 grid grid-cols-2 gap-3">
          {ningboGallery.map((photo) => (
            <div class="overflow-hidden rounded-lg border border-[var(--color-line)]">
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[300, 480, 640]}
                sizes="(min-width: 768px) 260px, 45vw"
                class="h-40 w-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Ho Chi Minh City, Vietnam</h3>
        <div class="mt-3 grid grid-cols-2 gap-3">
          {vietnamGallery.map((photo) => (
            <div class="overflow-hidden rounded-lg border border-[var(--color-line)]">
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[300, 480, 640]}
                sizes="(min-width: 768px) 260px, 45vw"
                class="h-40 w-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <details id="compare" class="group rounded-lg border border-[var(--color-line)] bg-white">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-semibold text-[var(--color-navy)] md:hidden">
        <span>Full side-by-side comparison</span>
        <span class="text-[var(--color-steel)] transition group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-[var(--color-line)] bg-[var(--color-bg)]">
            <th class="w-40 px-5 py-4 font-semibold text-[var(--color-navy)]">&nbsp;</th>
            <th class="px-5 py-4 font-semibold text-[var(--color-navy)]">Ningbo, China</th>
            <th class="px-5 py-4 font-semibold text-[var(--color-navy)]">Ho Chi Minh City, Vietnam</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([label, china, vietnam]) => (
            <tr class="border-b border-[var(--color-line)] align-top last:border-0">
              <th class="w-40 px-5 py-4 font-medium text-slate-500">{label}</th>
              <td class="px-5 py-4 leading-relaxed text-slate-700">
                {Array.isArray(china) ? (
                  <ul class="list-disc space-y-1 pl-4">
                    {china.map((item) => (
                      <li class:list={item === "—" && "list-none -ml-4 text-slate-400"}>{item}</li>
                    ))}
                  </ul>
                ) : (
                  china
                )}
              </td>
              <td class="px-5 py-4 leading-relaxed text-slate-700">
                {Array.isArray(vietnam) ? (
                  <ul class="list-disc space-y-1 pl-4">
                    {vietnam.map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  vietnam
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </details>
  </section>

  <script>
    const compare = document.getElementById("compare") as HTMLDetailsElement | null;
    if (compare && window.matchMedia("(min-width: 768px)").matches) compare.open = true;
  </script>

  <CtaBanner heading="Ask us which base fits your project" body="Send your target market, tariff situation and volume — we'll recommend China, Vietnam, or both." />
</Layout>
