---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PhotoBand from "../components/PhotoBand.astro";
import CtaBanner from "../components/CtaBanner.astro";
import assemblyPhoto from "../assets/photos/video-assembly-line.jpg";

const icons: Record<string, string> = {
  kitchen: '<rect x="20" y="6" width="24" height="22" rx="4"/><path d="M28 12v10M36 12v10M32 28v6"/><rect x="28" y="34" width="8" height="24" rx="4"/>',
  home: '<path d="M8 30 32 10l24 20"/><path d="M14 26v28h36V26"/><path d="M27 54V38h10v16"/>',
  pet: '<path d="M32 36c-8 0-14 6-12 12 1.5 4 6 4 12 4s10.5 0 12-4c2-6-4-12-12-12z"/><circle cx="14" cy="28" r="5"/><circle cx="26" cy="17" r="5"/><circle cx="40" cy="17" r="5"/><circle cx="52" cy="28" r="5"/>',
  care: '<rect x="8" y="14" width="48" height="12" rx="3"/><path d="M14 26v24M22 26v24M30 26v24M38 26v24M46 26v24"/>',
  bath: '<path d="M12 24h40l-4 32H16z"/><path d="M20 24a12 12 0 0 1 24 0"/><path d="M22 36h20"/>',
  wood: '<rect x="6" y="22" width="52" height="20" rx="2"/><path d="M14 22v8M22 22v12M30 22v8M38 22v12M46 22v8"/>',
};

const categories = [
  { title: "Kitchen tools & accessories", body: "Handles, holders and hardware that combine molded plastic with metal components.", icon: "kitchen" },
  { title: "Home & living products", body: "Everyday products that need consistent fit, finish and assembly.", icon: "home" },
  { title: "Pet products", body: "Durable plastic and metal builds for daily use.", icon: "pet" },
  { title: "Personal care & grooming tools", body: "Including plastic and zinc-alloy razors — a category we build today.", icon: "care" },
  { title: "Bath accessories, storage & cleaning tools", body: "Molded and metal components assembled and packed as a finished product.", icon: "bath" },
  { title: "Woodworking tools", body: "Metal and plastic tool components built to spec.", icon: "wood" },
];
---

<Layout
  title="Industries"
  description="Kitchen, home, pet, personal care, bath and woodworking products — plastic and metal components, assembled, inspected and packed."
>
  <PageHero
    eyebrow="Industries"
    title="Products we build"
    lede="We're strongest on products that combine a molded plastic part with a metal component — and need assembly, inspection and packaging to finish the job."
  />

  <PhotoBand
    src={assemblyPhoto}
    alt="Cleanroom assembly and packaging line"
    caption="Assembly and packaging."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <div class="overflow-hidden rounded-lg border border-[var(--color-line)] bg-white">
          <div class="flex h-40 items-center justify-center bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-2)] text-white/85">
            <svg
              viewBox="0 0 64 64"
              class="h-20 w-20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[c.icon]}
            />
          </div>
          <div class="p-6">
            <h2 class="text-base font-semibold text-[var(--color-navy)]">{c.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaBanner heading="Don't see your category?" body="If it combines plastic and metal and needs assembly, tell us about it — we probably still fit." />
</Layout>
