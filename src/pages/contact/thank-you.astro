---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Thank You"
  description="Thanks for your enquiry. We'll get back to you within 2 business days."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">Request received</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-[var(--color-navy)] sm:text-4xl">
      Thanks — we've got your request.
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-slate-600">
      We'll review it and get back to you within 2 business days with a real
      reply, not an automated quote.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-[var(--color-steel)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-steel-light)]"
    >
      Back to Home
    </a>
  </section>
</Layout>
