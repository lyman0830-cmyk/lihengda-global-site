---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  fullTitle?: boolean;
}

const { title, description, fullTitle = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} · Lihengda Global`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Lihengda Global",
  alternateName: "Ningbo Lihengda Machinery Co., Ltd.",
  url: "https://lihengdaglobal.com",
  logo: "https://lihengdaglobal.com/logo.png",
  description:
    "Lihengda operates two manufacturing bases — Ningbo, China (est. 2009) and Ho Chi Minh City, Vietnam (est. 2025) — providing plastic injection molding, metal fabrication, CNC machining, assembly, inspection and packaging for OEM/ODM consumer products.",
  foundingDate: "2009",
  email: "lyman@lihengda.cc",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Building 2, No. 110 Xiwu Street, Fenghua District",
    addressLocality: "Ningbo",
    addressCountry: "CN",
  },
  department: [
    {
      "@type": "Organization",
      name: "Lihengda (Vietnam) International Co., Ltd.",
      foundingDate: "2025",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Plot No. 41, Map Sheet No. 6, Ba Tri Quarter, Tan Hiep Ward",
        addressLocality: "Ho Chi Minh City",
        addressCountry: "VN",
      },
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MCYEHNXXRB"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-MCYEHNXXRB');
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
