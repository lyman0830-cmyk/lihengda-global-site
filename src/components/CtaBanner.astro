---
interface Props {
  heading?: string;
  body?: string;
  buttonLabel?: string;
  href?: string;
}
const {
  heading = "Have a product to quote?",
  body = "Tell us what you're building and which base fits your project — we'll reply within 2 business days.",
  buttonLabel = "Request a Quote",
  href = "/contact/",
} = Astro.props;
---

<section class="bg-[var(--color-navy)]">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-14 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div>
      <h2 class="text-2xl font-bold text-white">{heading}</h2>
      <p class="mt-2 max-w-xl text-slate-300">{body}</p>
    </div>
    <a
      href={href}
      class="shrink-0 rounded-md bg-[var(--color-steel)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-steel-light)]"
    >
      {buttonLabel}
    </a>
  </div>
</section>
