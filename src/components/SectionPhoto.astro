---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  eyebrow?: string;
  heading?: string;
  heightClass?: string;
}
const {
  src,
  alt,
  eyebrow,
  heading,
  heightClass = "h-[58vh] min-h-[420px] max-h-[620px]",
} = Astro.props;
---

<section class={`relative w-full overflow-hidden ${heightClass}`}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>

  <div class="relative flex h-full flex-col items-start justify-end">
    <div class="mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-wide text-white/80">{eyebrow}</p>
      )}
      {heading && (
        <h2 class="mt-3 max-w-2xl text-2xl font-bold leading-snug text-white sm:text-3xl md:text-4xl">
          {heading}
        </h2>
      )}
      <slot />
    </div>
  </div>
</section>
