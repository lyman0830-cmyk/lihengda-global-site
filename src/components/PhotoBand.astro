---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  tall?: boolean;
}
const { src, alt, caption, tall = false } = Astro.props;
---

<section class:list={["relative w-full overflow-hidden bg-[var(--color-navy)]", tall ? "h-[64vh] min-h-[340px] max-h-[720px]" : "h-[46vh] min-h-[320px] max-h-[520px]"]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    class="h-full w-full object-cover"
    loading="eager"
  />
  {caption && (
    <p class="absolute bottom-0 right-0 bg-black/50 px-3 py-1.5 text-xs text-white/90">
      {caption}
    </p>
  )}
</section>
