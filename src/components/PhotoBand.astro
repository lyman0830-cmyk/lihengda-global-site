---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <Image
      src={src}
      alt={alt}
      widths={[640, 1024, 1600, 2200]}
      sizes="(min-width: 1152px) 1152px, 100vw"
      class="w-full rounded-lg border border-[var(--color-line)] object-cover"
      loading="eager"
    />
    {caption && <p class="mt-2 text-xs text-slate-500">{caption}</p>}
  </div>
</section>
