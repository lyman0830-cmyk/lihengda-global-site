---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<section class="relative h-[46vh] min-h-[320px] max-h-[520px] w-full overflow-hidden bg-[var(--color-navy)]">
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    class="h-full w-full object-cover"
    loading="eager"
  />
  {caption && (
    <p class="absolute bottom-0 right-0 bg-black/50 px-3 py-1.5 text-xs text-white/90">
      {caption}
    </p>
  )}
</section>
