---
import { Image } from "astro:assets";
import logo from "../assets/brand/lihengda-logo.png";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-navy)] text-slate-200">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 text-lg font-bold text-white">
        <Image src={logo} alt="Lihengda" class="h-8 w-auto brightness-0 invert" />
        Lihengda Global
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-300">
        Two manufacturing bases — Ningbo, China and Ho Chi Minh City, Vietnam.
        Plastic and metal consumer products, built complete: molding, metal
        fabrication, assembly, inspection and retail-ready packaging.
      </p>
    </div>

    <div>
      <div class="text-sm font-semibold text-white">Engineering &amp; Manufacturing</div>
      <ul class="mt-4 space-y-2 text-sm text-slate-300">
        <li><a class="hover:text-white" href="/manufacturing/#engineering">Engineering &amp; Development</a></li>
        <li><a class="hover:text-white" href="/manufacturing/injection-molding/">Injection Molding</a></li>
        <li><a class="hover:text-white" href="/manufacturing/sheet-metal-welding/">Sheet Metal &amp; Welding</a></li>
        <li><a class="hover:text-white" href="/manufacturing/cnc-machining/">CNC Machining</a></li>
        <li><a class="hover:text-white" href="/manufacturing/box-build-assembly/">Box-Build Assembly, Inspection &amp; Packaging</a></li>
      </ul>
    </div>

    <div>
      <div class="text-sm font-semibold text-white">Company</div>
      <ul class="mt-4 space-y-2 text-sm text-slate-300">
        <li><a class="hover:text-white" href="/china-vietnam/">China &amp; Vietnam</a></li>
        <li><a class="hover:text-white" href="/industries/">Industries</a></li>
        <li><a class="hover:text-white" href="/crowdfunding-to-production/">Crowdfunding to Production</a></li>
        <li><a class="hover:text-white" href="/about/">About &amp; Compliance</a></li>
        <li><a class="hover:text-white" href="/contact/">Request a Quote</a></li>
      </ul>
      <div class="mt-6 text-sm text-slate-300">
        <div>Lyman Li, Manager</div>
        <div><a class="hover:text-white" href="mailto:lyman@lihengdaglobal.com">lyman@lihengdaglobal.com</a></div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-6 text-xs text-slate-400 sm:px-6">
      &copy; {year} Lihengda. Ningbo Lihengda Machinery Co., Ltd. (China) and Lihengda (Vietnam) International Co., Ltd.
    </div>
  </div>
</footer>
