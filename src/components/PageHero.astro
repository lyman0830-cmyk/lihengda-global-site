---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="border-b border-[var(--color-line)] bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-steel)]">{eyebrow}</p>
    )}
    <h1 class="mt-3 max-w-3xl text-3xl font-bold tracking-tight text-[var(--color-navy)] sm:text-4xl md:text-5xl">
      {title}
    </h1>
    {lede && (
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">{lede}</p>
    )}
    <slot />
  </div>
</section>
